# GCP Always Free Tier Environment Configuration
# Copy this to .env and fill in your values

# External Database URLs (Free Tier)
# Get these from Neon (Postgres) and Upstash (Redis)
NEON_DATABASE_URL=postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
UPSTASH_REDIS_URL=redis://default:password@redis-xxx.upstash.io:6379

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Email Configuration (Optional - for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Car Platform
SMTP_TLS=true
SMTP_SSL=false

# SMS Configuration (Optional - for alerts)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Africa's Talking SMS (Alternative)
AT_USERNAME=your-at-username
AT_API_KEY=your-at-api-key
AT_SENDER_ID=your-sender-id

# Push Notifications (Optional)
FCM_SERVER_KEY=your-fcm-server-key

# Monitoring (Optional)
GRAFANA_PASSWORD=admin123

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
