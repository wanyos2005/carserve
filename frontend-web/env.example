# API Configuration
# Production: http://16.16.143.243 (port 80, goes through nginx gateway)
# Local: http://localhost:8000 (direct to service)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=DriveOn
NEXT_PUBLIC_APP_DESCRIPTION=Smart Car Management Platform

# Authentication (if needed)
NEXTAUTH_SECRET=your-secret-key
NEXTAUTH_URL=http://localhost:3000

# Analytics (optional)
NEXT_PUBLIC_GA_ID=your-google-analytics-id

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_CHAT=false
