# API Configuration
# Use the same backend URL as your Flutter app
# If backend is on AWS VM: http://16.16.143.243 (port 80, goes through nginx)
# If backend is running locally: http://localhost:8000
# NOTE: Use port 80 (or no port) to go through nginx gateway, not port 8000
NEXT_PUBLIC_API_URL=http://16.16.143.243

# Optional: Analytics
NEXT_PUBLIC_GA_ID=your-google-analytics-id